# Optional local configuration; no real credentials are required.
# Export these variables in your shell; the server does not auto-load .env.
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# React opened at 127.0.0.1 or another port needs its own exact allowed origin:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Opt in to local fixtures using BOTH settings below, from backend/:
# APP_ENV=local
# LOCAL_CATALOG_FILE=./testdata/catalog.local.json
# APP_ENV=local binds the API to 127.0.0.1 only.
# In production leave LOCAL_CATALOG_FILE unset; fixtures outside local fail startup.
